hxconda.hxml

--next

-cp src
-main Main

-lib haxeui-core
-lib haxeui-html5
-lib morestd
-lib haxefolio
-lib jsonmodel
-lib easyrest
-lib easypubsub
-lib intellectorboard

--macro client.build.BuildInfoMacro.register()
-js bin/app.js

-resource assets/images/common/board/controls/annotate_generic.svg@annotate_generic
-resource assets/resources/changelog.json@changelog
-resource assets/resources/event_days.json@event_days
