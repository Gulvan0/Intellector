<?xml version="1.0" encoding="utf-8" ?>
<module id="intellector">
    <resources>
        <resource path="assets/locale" prefix="intellector/locale" />
        <resource path="assets/styles" prefix="intellector/styles" />
        <resource path="assets/layouts" prefix="intellector/layouts" />
        <resource path="assets/fonts" prefix="intellector/fonts" />
    </resources>

    <components>
        <!-- classes usable as XML layout tags (each needs a no-argument constructor) -->
        <class name="client.ui.common.notifications.challenges.TimeControlTag" />
    </components>

    <locales>
        <locale id="en">
            <resource path="intellector/locale/en.properties" />
        </locale>
        <locale id="ru">
            <resource path="intellector/locale/ru.properties" />
        </locale>
    </locales>

    <themes>
        <default>
            <var name="site-name-family" value="intellector/fonts/MontserratAlternates-Medium.woff2" />

            <style resource="intellector/styles/main.css" priority="10" />
        </default>
    </themes>
</module>
