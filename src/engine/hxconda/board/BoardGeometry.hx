    private static final FINAL_SQUARE_FLAGS:Array<Bool> = computeFinalSquareFlags();

    public static inline function areAdjacent(square:Int, otherSquare:Int):Bool
    {
        return ADJACENCY[square * SQUARE_COUNT + otherSquare];
    }

    /** Whether `square` lies on the last row for `color`, where its progressors promote and its intellector wins **/
    public static inline function isFinalSquare(square:Int, color:PlayerColor):Bool
    {
        return FINAL_SQUARE_FLAGS[color * SQUARE_COUNT + square];
    }

