    public static function rayLength(rays:SquareLists, square:Int):Int
    {
        var length:Int = 0;
        for (direction in 0...DIRECTION_COUNT)
            length += rays.size(square * DIRECTION_COUNT + direction);
        return length;
    }

    private static function computeAdjacency():Array<Bool>
    {
        var adjacency:Array<Bool> = [for (_ in 0...SQUARE_COUNT * SQUARE_COUNT) false];
        for (square in 0...SQUARE_COUNT)
            for (neighbour in NEIGHBOUR_SOURCE[square])
                adjacency[square * SQUARE_COUNT + neighbour] = true;
        return adjacency;
    }

    private static function computeFinalSquareFlags():Array<Bool>
    {
        var flags:Array<Bool> = [for (_ in 0...2 * SQUARE_COUNT) false];
        for (square in WHITE_FINAL_SQUARES)
            flags[PlayerColor.White * SQUARE_COUNT + square] = true;
        for (square in BLACK_FINAL_SQUARES)
            flags[PlayerColor.Black * SQUARE_COUNT + square] = true;
        return flags;
    }
}
